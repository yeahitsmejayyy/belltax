{
  "name": "belltaxprep",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @app/server dev",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "seed": "bun --filter @app/server seed",
    "migrate": "bun --filter @app/server migrate",
    "backup": "bun --filter @app/server backup",
    "backup:verify": "bun --filter @app/server backup:verify",
    "restore": "bun --filter @app/server restore",
    "live:check": "bun --filter @app/server live:check",
    "start": "bun --filter @app/server start",
    "purge": "bun --filter @app/server purge",
    "export": "bun --filter @app/server export",
    "export:open": "bun --filter @app/server export:open",
    "bench:seed": "bun --filter @app/server bench:seed",
    "bench": "bun --filter @app/server bench",
    "sync:types": "bun scripts/sync-types.ts",
    "dev:portal": "bun --filter @app/portal dev",
    "dev:admin": "bun --filter @app/admin dev",
    "build": "bun --filter @app/portal build && bun --filter @app/admin build && bun --filter @app/site build",
    "check:data": "bun scripts/check-no-real-data.ts",
    "intake:doc": "bun scripts/intake-doc.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "test:storybook": "vitest run --project=storybook",
    "dev:site": "bun --filter @app/site dev",
    "preparer:invite": "bun --filter @app/server preparer:invite",
    "email:test": "bun --filter @app/server email:test"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.4.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "vite": "^7.3.7"
  }
}
