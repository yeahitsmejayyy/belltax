{
  "name": "belltaxprep",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @app/server dev",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "seed": "bun --filter @app/server seed",
    "migrate": "bun --filter @app/server migrate",
    "backup": "bun --filter @app/server backup",
    "backup:verify": "bun --filter @app/server backup:verify",
    "restore": "bun --filter @app/server restore",
    "live:check": "bun --filter @app/server live:check",
    "start": "bun --filter @app/server start",
    "purge": "bun --filter @app/server purge"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
