# demo = seeded fake households, safe to show anyone. live = real clients, local only.
RUN_MODE=demo
PORT=3000
# Required in live mode. Absolute path, must be outside this repo.
LIVE_DATA_DIR=
# Optional: paying online with Stripe, TEST keys only (docs/stripe.md). Both or neither.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional, live only: outgoing email with Resend (docs/email.md). Without them, mail goes to the admin's Outbox.
RESEND_API_KEY=
EMAIL_FROM=
