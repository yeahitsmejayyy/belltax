{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4599",
        "--bind",
        "127.0.0.1",
        "--directory",
        ".docs"
      ],
      "port": 4599
    },
    {
      "name": "server",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "portal",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev:portal"
      ],
      "port": 5173
    },
    {
      "name": "admin",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev:admin"
      ],
      "port": 5174
    },
    {
      "name": "storybook",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "storybook"
      ],
      "port": 6006
    }
  ]
}