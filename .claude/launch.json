{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4599",
        "--bind",
        "127.0.0.1",
        "--directory",
        ".docs"
      ],
      "port": 4599
    },
    {
      "name": "server",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "portal",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev:portal"
      ],
      "port": 5175
    },
    {
      "name": "admin",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev:admin"
      ],
      "port": 5174
    },
    {
      "name": "site",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev:site"
      ],
      "port": 5176
    },
    {
      "name": "storybook",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "storybook"
      ],
      "port": 6006
    },
    {
      "name": "storybook-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "6011",
        "--bind",
        "127.0.0.1",
        "--directory",
        "storybook-static"
      ],
      "port": 6011
    }
  ]
}
